# Copy to .env and change every value before deploying.
POSTGRES_DB=taskman
POSTGRES_USER=taskman
POSTGRES_PASSWORD=change-me

# Must match POSTGRES_* because the API connects to the db service.
Database__ConnectionString=Host=db;Port=5432;Database=taskman;Username=taskman;Password=change-me

Storage__AttachmentsPath=/data/attachments
Storage__KeysPath=/data/keys

# Required on first startup to seed the administrator (8-128 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_DISPLAY_NAME=Administrator

AUTH__COOKIESECURE=false
Auth__SessionIdleHours=8
Auth__SessionAbsoluteDays=7
Auth__LoginPermitLimit=10
Auth__LoginWindowSeconds=60
SWAGGER__ENABLED=false
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
ForwardedHeaders__KnownNetworks=172.16.0.0/12

# Optional: host port for the development database override.
# DB_PORT=5432
